{var parsed_url=frame.config.url.replaceTokens(fn_user_lmd);frame.config.url=parsed_url;}}}
if(init_ebayDoc)
{ebayDoc.onLoad();}}
if(typeof(ebay)!="undefined")
{ebay._registerListener(ebay.oDocument._getEvent("load"),ebay.EVENT_BEFORE,"eBayFavNavOnload");}
